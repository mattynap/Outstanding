{
  "name": "@outstanding/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "android:assets": "node assets/make-art.mjs && capacitor-assets generate --android --iconBackgroundColor #0b1f15 --iconBackgroundColorDark #0b1f15 --splashBackgroundColor #0b1f15 --splashBackgroundColorDark #0b1f15",
    "android:apk": "ng build && cap sync android && cd android && .\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@ionic/angular": "^9.0.11",
    "@outstanding/config": "workspace:*",
    "@outstanding/content": "workspace:*",
    "@outstanding/engine": "workspace:*",
    "fflate": "^0.8.3",
    "ionicons": "^8.1.0",
    "phaser": "4.2.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "zod": "^4.6.7",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  }
}
